.profile-soundtrack{--soundtrack-accent:var(--experience-accent,#fff200);width:min(100%,430px);color:inherit;font-family:inherit}.profile-soundtrack button{color:inherit;font:inherit}.profile-soundtrack__header,.profile-soundtrack__controls{display:flex;align-items:center;gap:10px}.profile-soundtrack__header{justify-content:space-between}.profile-soundtrack__identity{display:flex;min-width:0;align-items:center;gap:9px;padding:0;border:0;background:transparent;cursor:pointer;text-align:left}.profile-soundtrack__identity>span:first-child{color:var(--soundtrack-accent)}.profile-soundtrack__identity>span:last-child{display:grid;min-width:0;gap:2px}.profile-soundtrack__identity strong,.profile-soundtrack__identity small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.profile-soundtrack__identity strong{font:700 10px "Courier New",monospace;letter-spacing:.07em;text-transform:uppercase}.profile-soundtrack__identity small,.profile-soundtrack__count{font:7px "Courier New",monospace;opacity:.48}.profile-soundtrack__controls{margin-top:12px}.profile-soundtrack__controls>button{display:grid;width:28px;height:28px;flex:0 0 auto;place-items:center;padding:0;border:1px solid color-mix(in srgb,currentColor 18%,transparent);border-radius:50%;background:transparent;cursor:pointer;font-size:8px}.profile-soundtrack__controls>button:disabled{opacity:.28;cursor:not-allowed}.profile-soundtrack__controls .profile-soundtrack__play{border-color:var(--soundtrack-accent)}.profile-soundtrack__timeline{display:grid;min-width:0;flex:1;gap:4px}.profile-soundtrack__timeline input{width:100%;margin:0;accent-color:var(--soundtrack-accent)}.profile-soundtrack__timeline>div{display:flex;justify-content:space-between;font:7px "Courier New",monospace;opacity:.45}.profile-soundtrack__playlist{display:grid;max-height:0;gap:4px;overflow:hidden;opacity:0;transition:max-height .26s ease,margin-top .26s ease,opacity .18s ease}.profile-soundtrack--expanded .profile-soundtrack__playlist{max-height:320px;margin-top:14px;overflow-y:auto;opacity:1}.profile-soundtrack__playlist>button{display:grid;grid-template-columns:24px minmax(0,1fr) auto;align-items:center;gap:9px;padding:8px;border:1px solid transparent;background:transparent;cursor:pointer;text-align:left}.profile-soundtrack__playlist>button:hover,.profile-soundtrack__playlist>button[data-active="true"]{border-color:color-mix(in srgb,currentColor 16%,transparent);background:color-mix(in srgb,currentColor 6%,transparent)}.profile-soundtrack__playlist>button>span:first-child,.profile-soundtrack__playlist em{font:7px "Courier New",monospace;font-style:normal;opacity:.48}.profile-soundtrack__playlist>button>span:nth-child(2){display:grid;min-width:0;gap:2px}.profile-soundtrack__playlist strong,.profile-soundtrack__playlist small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.profile-soundtrack__playlist strong{font-size:9px}.profile-soundtrack__playlist small{font-size:7px;opacity:.5}.profile-soundtrack>audio{display:none}.profile-soundtrack--editorial{--soundtrack-accent:#9b2f25;padding-top:10px;border-top:1px solid var(--experience-border)}.profile-soundtrack--utility{--soundtrack-accent:#ff4e00;width:100%;padding:9px;border:1px solid #111;background:#fff}.profile-soundtrack--utility .profile-soundtrack__controls>button,.profile-soundtrack--pixel .profile-soundtrack__controls>button{border-radius:0}.profile-soundtrack--graphite{--soundtrack-accent:#e6a23c;width:100%}.profile-soundtrack--pixel{--soundtrack-accent:#ff8ad4;width:100%;font-family:"Courier New",monospace}.profile-soundtrack--stardust{--soundtrack-accent:#ffc9ff;width:100%}.profile-soundtrack--release{--soundtrack-accent:#fff200;width:100%}@media(prefers-reduced-motion:reduce){.profile-soundtrack__playlist{transition:none}}

/* Hidden autoplay visitor control */
.profile-soundtrack--hidden { position: fixed; right: 18px; bottom: 18px; z-index: 12500; width: auto; min-width: 0; padding: 8px; border: 1px solid rgba(255,255,255,.18); border-radius: 999px; background: rgba(11,11,12,.88); box-shadow: 0 12px 38px rgba(0,0,0,.28); backdrop-filter: blur(18px); }
.profile-soundtrack--hidden .profile-soundtrack__header { display: none; }
.profile-soundtrack--hidden .profile-soundtrack__controls { margin: 0; }
.profile-soundtrack--hidden .profile-soundtrack__controls > button:not(.profile-soundtrack__play),
.profile-soundtrack--hidden .profile-soundtrack__timeline,
.profile-soundtrack--hidden .profile-soundtrack__playlist { display: none; }
.profile-soundtrack--hidden .profile-soundtrack__play { width: 34px; height: 34px; }
@media (max-width: 620px) { .profile-soundtrack--hidden { right: 12px; bottom: 12px; } }
